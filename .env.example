# ComfyUI-Copilot environment configuration
#
# This file is the canonical reference for every environment variable the
# Copilot backend reads. Copy to `.env` and fill in real values.
#
# Loaded by: backend/utils/globals.py via python-dotenv at import time.
# Location:  <custom_nodes>/ComfyUI-Copilot/.env
#
# Marking convention:
#   [REQUIRED]  Preflight will fail fast if missing.
#   [OPTIONAL]  Has a sensible fallback; only set to override.
#   [LEGACY]    Read by upstream code but not used in this deployment.

# =============================================================================
# Chat LLM (OpenAI-compatible endpoint used by the main chat path)
# =============================================================================
# [REQUIRED] Points at the Mac-hosted MLX server on the Studio (10GbE direct)
CC_OPENAI_API_KEY=devstral-local
CC_OPENAI_BASE_URL=http://192.168.10.2:8091/v1

# =============================================================================
# Workflow LLM (used by workflow-gen path; can be same as chat LLM)
# =============================================================================
# [REQUIRED] Same endpoint works for both chat and workflow generation
WORKFLOW_LLM_API_KEY=devstral-local
WORKFLOW_LLM_BASE_URL=http://192.168.10.2:8091/v1
WORKFLOW_LLM_MODEL=mlx-community/mistralai_Devstral-Small-2-24B-Instruct-2512-MLX-4Bit

# =============================================================================
# RAG Agent (Mac Studio — workflow search / generation pipeline)
# =============================================================================
# [REQUIRED] Base URL of the RAG service. agent_factory.py appends "/agent".
RAG_API_URL=http://192.168.10.2:7001
# [REQUIRED] X-API-Key header. Requests without a valid key get HTTP 403.
RAG_API_KEY=claude_highway_808

# =============================================================================
# MCP Server (Mac Studio — Copilot MCP tool server)
# =============================================================================
# [REQUIRED] Streamable-HTTP MCP endpoint. If not set, Copilot falls back to
# the cloud Render.com server, which is NOT what we want on this machine.
COPILOT_MCP_URL=http://192.168.10.2:7002/mcp
# [OPTIONAL] Initial RPC timeout in seconds. Default 30. The name says "connect"
# but it really controls how long we wait for the full MCP handshake
# (SSE endpoint + initialize RPC + tools/list RPC) to complete. Raised from
# the original 8 on 2026-04-13 because on a Mac MCP cold start the Korean→
# English translator + RAG embedding models are lazy-loaded during tools/list,
# which regularly exceeded 8s. Warm reconnects still take <200ms.
# COPILOT_MCP_CONNECT_TIMEOUT_SECONDS=30

# =============================================================================
# SMB path sharing (W6) — zero-copy image handoff to Mac RAG
# =============================================================================
# Windows writes an image under SMB_WIN_ROOT; Mac reads the same bytes at
# SMB_MAC_ROOT (via its SMB mount). The diagnose_image tool uses this to
# avoid base64-inlining large images across HTTP.
#
# Precondition: Mac must have \\<windows>\share mounted at SMB_MAC_ROOT. The
# mount is currently manual-persistence on Mac, so after a Mac reboot it must
# be re-mounted before large-image diagnose calls will succeed. When the mount
# is down, you will see "Error" / file-not-found in the Mac response; the tool
# then falls back to base64 automatically but prints [mode=base64] so it is
# obvious what happened.
#
# [REQUIRED for diagnose_image] Windows-side root of the shared folder.
SMB_WIN_ROOT=D:\share
# [REQUIRED for diagnose_image] Mac-side mount point of the same share.
SMB_MAC_ROOT=/Volumes/share
# [OPTIONAL] Threshold in bytes. Images at or above this size are sent as
# image_path; smaller ones go base64 inline. Default 2 MiB (2097152).
IMAGE_PATH_MIN_BYTES=2097152

# =============================================================================
# External MCP (ModelScope/Bing) - OPTIONAL, defaults to OFF
# =============================================================================
# Security default: external MCP is disabled. When enabled, Copilot will
# connect only for explicit web-search requests (unless you disable that guard).
# NOTE: This uses a dedicated external token. Internal Copilot bearer tokens
# are never forwarded to external MCP.
# BING_MCP_ENABLED=false
# BING_MCP_REQUIRE_EXPLICIT_WEB_SEARCH=true
# BING_MCP_URL=https://mcp.api-inference.modelscope.net/8c9fe550938e4f/sse
# BING_MCP_API_KEY=

# =============================================================================
# Backend base URL (origin server for cloud-hosted features)
# =============================================================================
# [OPTIONAL] Default: https://comfyui-copilot-server.onrender.com
# Only relevant if you actually use cloud features. Local-only deployments
# can ignore this.
# BACKEND_BASE_URL=

# =============================================================================
# Tenancy / feature flags
# =============================================================================
# [OPTIONAL] Tenant id for multi-tenant cloud. Local-only: leave empty.
# TENANT_ID=
# [OPTIONAL] Set to 1 to disable the workflow generator entirely.
# DISABLE_WORKFLOW_GEN=

# =============================================================================
# Legacy / unused on this machine
# =============================================================================
# [LEGACY] Kept for upstream compatibility. Not exercised in this deployment:
#   WORKFLOW_MODEL_NAME, GOOGLE_OPENAI_COMPAT_BASE_URL, DEFAULT_GEMINI_MODEL
